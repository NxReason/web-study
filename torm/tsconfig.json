{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["node"],

    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true,
  },
  "include": ["src/**/*.ts"]
}